use std.Net.TcpStream
use std.Net.TcpListener
use std.Net.NetworkIssue

class

public static native listenTcp(port: Int): TcpListener, !NetworkIssue = "forge_net_listen_tcp"
public static async native acceptTcp(listener: TcpListener): TcpStream, !NetworkIssue = "forge_net_accept_tcp"
public static async native connectTcp(host: String, port: Int): TcpStream, !NetworkIssue = "forge_net_connect_tcp"
public static async native read(stream: TcpStream, maxBytes: Int): Byte[], !NetworkIssue = "forge_net_read"
public static async native write(stream: TcpStream, bytes: Byte[]): Int, !NetworkIssue = "forge_net_write"
public static native closeListener(listener: TcpListener): Void = "forge_net_close_listener"
public static native close(stream: TcpStream): Void = "forge_net_close"
