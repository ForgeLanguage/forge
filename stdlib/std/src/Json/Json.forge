use std.Json.JsonIssue
use std.Json.JsonValue

class

public static native func parse(text: String): JsonValue, !JsonIssue = "forge_json_parse"
public static native func get(value: JsonValue, name: String): JsonValue, !JsonIssue = "forge_json_get"
public static native func at(value: JsonValue, index: Int): JsonValue, !JsonIssue = "forge_json_at"
public static native func length(value: JsonValue): Int, !JsonIssue = "forge_json_length"
public static native func asString(value: JsonValue): String, !JsonIssue = "forge_json_as_string"
public static native func asInt(value: JsonValue): Int, !JsonIssue = "forge_json_as_int"
public static native func asDouble(value: JsonValue): Double, !JsonIssue = "forge_json_as_double"
public static native func asBool(value: JsonValue): Bool, !JsonIssue = "forge_json_as_bool"
public static native func isNull(value: JsonValue): Bool, !JsonIssue = "forge_json_value_is_null"
public static native func getString(value: JsonValue, name: String): String, !JsonIssue = "forge_json_get_string"
public static native func getInt(value: JsonValue, name: String): Int, !JsonIssue = "forge_json_get_int"
public static native func getDouble(value: JsonValue, name: String): Double, !JsonIssue = "forge_json_get_double"
public static native func getBool(value: JsonValue, name: String): Bool, !JsonIssue = "forge_json_get_bool"
public static native func getIntArray(value: JsonValue, name: String): Int[], !JsonIssue = "forge_json_get_int_array"
public static native func values(value: JsonValue): JsonValue[], !JsonIssue = "forge_json_values"
public static native func isFieldNull(value: JsonValue, name: String): Bool, !JsonIssue = "forge_json_is_null"
public static native func writeString(value: String): String = "forge_json_write_string"

public static func readString(value: JsonValue): String, !JsonIssue {
    return forward Json.asString(value)
}

public static func readInt(value: JsonValue): Int, !JsonIssue {
    return forward Json.asInt(value)
}

public static func readDouble(value: JsonValue): Double, !JsonIssue {
    return forward Json.asDouble(value)
}

public static func readBool(value: JsonValue): Bool, !JsonIssue {
    return forward Json.asBool(value)
}

public static func writeInt(value: Int): String {
    return value.toString()
}

public static func writeDouble(value: Double): String {
    return value.toString()
}

public static func writeBool(value: Bool): String {
    if value {
        return "true"
    }
    return "false"
}

public static func writeStringArray(values: String[]): String {
    let result: String = "["
    let separator: String = ""
    for values as value {
        result = result + separator + Json.writeString(value)
        separator = ","
    }
    return result + "]"
}

public static func writeIntArray(values: Int[]): String {
    let result: String = "["
    let separator: String = ""
    for values as value {
        result = result + separator + Json.writeInt(value)
        separator = ","
    }
    return result + "]"
}

public static func writeDoubleArray(values: Double[]): String {
    let result: String = "["
    let separator: String = ""
    for values as value {
        result = result + separator + Json.writeDouble(value)
        separator = ","
    }
    return result + "]"
}

public static func writeBoolArray(values: Bool[]): String {
    let result: String = "["
    let separator: String = ""
    for values as value {
        result = result + separator + Json.writeBool(value)
        separator = ","
    }
    return result + "]"
}

public static template func parse<T:struct>(text: String): T, !JsonIssue {
    const value = forward Json.parse(text)
    return forward Json.read<T>(value)
}

