}

public static template func stringifyArray<T:struct>(values: T[]): String {
    let result: String = "["
    let separator: String = ""
    for values as value {
        result = result + separator + Json.stringify<#{T}>(value)
        separator = ","
    }
    return result + "]"
}

public static template func readArray<T:struct>(value: JsonValue): T[], !JsonIssue {
    const values = forward Json.values(value)
    const result = catch Json.read<T>[values] {
        issue: JsonIssue => {
            return issue
        }
    }
    return result
}

