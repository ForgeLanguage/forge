class <T>

private var items: T[]
private var count: Int

public static create(capacity: Int): List<T> {
    const list = List<T>.new()
    list.items = Array.new<T>(capacity)
    list.count = 0
    return move list
}

public push(value: T): Void {
    if this.count == this.items.len {
        this.grow()
    }
    this.items[this.count] = value
    this.count = this.count + 1
}

public set(index: Int, value: T): Void {
    this.items[index] = value
}

public at(index: Int): T {
    return this.items[index]
}

public length(): Int {
    return this.count
}

public toArray(): T[] {
    var result: T[] = Array.new<T>(this.count)
    var index: Int = 0
    while index < this.count {
        result[index] = this.items[index]
        index += 1
    }
    return result
}

private grow(): Void {
    const nextCapacity = this.items.len == 0 ? 1 : this.items.len * 2
    var resized: T[] = Array.new<T>(nextCapacity)
    var index: Int = 0
    while index < this.count {
        resized[index] = this.items[index]
        index += 1
    }
    this.items = resized
}
