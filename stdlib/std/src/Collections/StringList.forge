class

private var items: String[]
private var count: Int

public static create(capacity: Int): StringList {
    const list = StringList.new()
    list.items = Array.new<String>(capacity)
    list.count = 0
    return move list
}

public push(value: String): Void {
    if this.count == this.items.len {
        this.grow()
    }
    this.items[this.count] = value + ""
    this.count = this.count + 1
}

public set(index: Int, value: String): Void {
    this.items[index] = value + ""
}

public at(index: Int): String {
    return this.items[index]
}

public length(): Int {
    return this.count
}

public contains(value: String): Bool {
    var index: Int = 0
    while index < this.count {
        if this.items[index].equals(value) {
            return true
        }
        index += 1
    }
    return false
}

public toArray(): String[] {
    var result: String[] = Array.new<String>(this.count)
    var index: Int = 0
    while index < this.count {
        result[index] = this.items[index] + ""
        index += 1
    }
    return result
}

private grow(): Void {
    const nextCapacity = this.items.len == 0 ? 1 : this.items.len * 2
    var resized: String[] = Array.new<String>(nextCapacity)
    var index: Int = 0
    while index < this.count {
        resized[index] = this.items[index] + ""
        index += 1
    }
    this.items = resized
}
